---
// Base layout — skeleton only; header/footer/design arrive in the design sprint.
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'njX Store — Astro ecommerce starter',
  description = 'Ecommerce storefront starter on Astro + Tailwind: mock data out of the box, Shopify with two env vars.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen bg-neutral-950 text-neutral-100 antialiased">
    <header class="border-b border-neutral-800 px-6 py-4">
      <nav class="mx-auto flex max-w-6xl items-center justify-between">
        <a href="/" class="text-lg font-black tracking-tight">njX Store</a>
        <div class="flex gap-5 text-sm text-neutral-400">
          <a href="/collections/apparel" class="hover:text-white">Apparel</a>
          <a href="/collections/desk" class="hover:text-white">Desk</a>
          <a href="/collections/coffee" class="hover:text-white">Coffee</a>
        </div>
      </nav>
    </header>
    <main class="mx-auto max-w-6xl px-6 py-10">
      <slot />
    </main>
    <footer class="border-t border-neutral-800 px-6 py-8 text-center text-sm text-neutral-500">
      astro-njx-store · skeleton build
    </footer>
  </body>
</html>
