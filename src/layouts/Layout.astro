---
// Offhours — base layout: announcement bar, header with live cart button,
// cart drawer (client-side, nanostores), footer.
import '../styles/global.css';
import { providerName } from '../lib/commerce';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Offhours — good gear for long builds',
  description =
    'Demo storefront for astro-njx-store: apparel, desk goods and coffee. Astro + Tailwind, mock data out of the box, Shopify with two env vars.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-paper font-sans text-ink antialiased" data-provider={providerName}>
    <p class="flex flex-wrap items-center justify-center gap-x-2 bg-pine px-4 py-2 text-center text-[13px] font-medium text-pine-soft">
      <span>Free shipping on orders over $75 — roasted and packed every Monday</span>
      <span class="opacity-50">·</span>
      <a
        href="https://github.com/njbSaab/astro-njx-store"
        target="_blank"
        rel="noopener"
        class="font-semibold text-white underline underline-offset-2 hover:opacity-90"
      >Please ⭐️ on GitHub</a>
    </p>

    <header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur">
      <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
        <div class="flex items-center gap-3">
          <button
            id="menu-button"
            class="-ml-1 rounded-md p-2 hover:bg-tile sm:hidden"
            aria-label="Open menu"
            aria-expanded="false"
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <path d="M3 5.5h14M3 10h14M3 14.5h14" />
            </svg>
          </button>
          <a href="/" class="font-display text-[22px] font-bold tracking-tight">Offhours</a>
        </div>
        <div class="hidden gap-7 text-[15px] text-muted sm:flex">
          <a href="/collections/apparel" class="hover:text-ink">Apparel</a>
          <a href="/collections/desk" class="hover:text-ink">Desk</a>
          <a href="/collections/coffee" class="hover:text-ink">Coffee</a>
        </div>
        <button
          id="cart-button"
          class="relative flex items-center gap-1.5 rounded-md border border-line px-3.5 py-2.5 hover:border-ink"
          aria-label="Open cart"
        >
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1.4" />
            <circle cx="19" cy="21" r="1.4" />
            <path d="M2.5 3h2l2.6 12.6a2 2 0 0 0 2 1.6h9.2a2 2 0 0 0 2-1.6L22 7H6" />
          </svg>
          <span
            id="cart-count"
            class="hidden rounded-full bg-pine px-2 py-0.5 text-[12px] font-semibold text-white"
          ></span>
        </button>
      </nav>
      <!-- mobile menu -->
      <div id="mobile-menu" class="hidden border-t border-line bg-paper sm:hidden">
        <a href="/collections/apparel" class="block border-b border-line px-5 py-3.5 text-[16px] font-medium">Apparel</a>
        <a href="/collections/desk" class="block border-b border-line px-5 py-3.5 text-[16px] font-medium">Desk & setup</a>
        <a href="/collections/coffee" class="block px-5 py-3.5 text-[16px] font-medium">Coffee</a>
      </div>
    </header>

    <slot />

    <footer class="mt-24 border-t border-line bg-tile/60">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-3">
        <div>
          <p class="font-display text-xl font-bold">Offhours</p>
          <p class="mt-3 max-w-[36ch] text-[14px] leading-relaxed text-muted">
            Good gear for long builds. A demo store for the astro-njx-store theme —
            every product here is fictional, the checkout is real.
          </p>
        </div>
        <div class="text-[14px]">
          <p class="font-semibold">Shop</p>
          <ul class="mt-3 space-y-2 text-muted">
            <li><a href="/collections/apparel" class="hover:text-ink">Apparel</a></li>
            <li><a href="/collections/desk" class="hover:text-ink">Desk & setup</a></li>
            <li><a href="/collections/coffee" class="hover:text-ink">Coffee</a></li>
          </ul>
        </div>
        <div class="text-[14px]">
          <p class="font-semibold">Theme</p>
          <ul class="mt-3 space-y-2 text-muted">
            <li><a href="https://github.com/njbSaab/astro-njx-store" class="hover:text-ink">astro-njx-store on GitHub</a></li>
            <li><a href="https://njxui.dev" class="hover:text-ink">Made by njX</a></li>
            <li><a href="https://astro.build" class="hover:text-ink">Built with Astro</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <!-- ── Demo thank-you modal ── -->
    <div id="thanks-modal" class="fixed inset-0 z-[60] hidden items-center justify-center p-5">
      <div class="absolute inset-0 bg-ink/50" data-thanks-close></div>
      <div class="relative w-full max-w-sm rounded-xl bg-paper p-8 text-center shadow-2xl">
        <p class="text-4xl">🎉</p>
        <h3 class="mt-3 font-display text-2xl font-bold">Thanks for the order!</h3>
        <p class="mt-2 text-[14px] leading-relaxed text-muted">
          This is a demo store, so nothing was charged. If you like the theme,
          a star takes two seconds and helps a lot.
        </p>
        <a
          href="https://github.com/njbSaab/astro-njx-store"
          target="_blank"
          rel="noopener"
          class="mt-5 block w-full rounded-md bg-pine py-3 text-[15px] font-semibold text-white hover:bg-pine-deep"
        >⭐️ Star on GitHub</a>
        <button data-thanks-close class="mt-2 w-full rounded-md py-2.5 text-[14px] text-muted hover:text-ink">
          Keep browsing
        </button>
        <p class="mt-3 text-[12px] text-muted">
          Made by <a href="https://njxui.dev" target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-ink">njX UI</a>
        </p>
      </div>
    </div>

    <!-- ── Cart drawer ── -->
    <div id="cart-backdrop" class="fixed inset-0 z-40 bg-ink/40" aria-hidden="true"></div>
    <aside
      id="cart-drawer"
      class="fixed inset-y-0 right-0 z-50 flex w-full max-w-md flex-col bg-paper shadow-2xl"
      aria-label="Shopping cart"
    >
      <div class="flex items-center justify-between border-b border-line px-6 py-5">
        <h2 class="font-display text-xl font-bold">Your cart</h2>
        <button id="cart-close" class="rounded-md p-2 text-muted hover:text-ink" aria-label="Close cart">✕</button>
      </div>
      <div id="cart-lines" class="flex-1 overflow-y-auto px-6 py-4"></div>
      <div class="border-t border-line px-6 py-5">
        <div class="flex items-center justify-between text-[15px]">
          <span class="text-muted">Subtotal</span>
          <span id="cart-subtotal" class="font-semibold">$0</span>
        </div>
        <p class="mt-1 text-[13px] text-muted">Shipping and taxes calculated at checkout.</p>
        <button
          id="cart-checkout"
          class="mt-4 w-full rounded-md bg-pine py-3.5 text-[15px] font-semibold text-white hover:bg-pine-deep disabled:cursor-not-allowed disabled:opacity-50"
        >
          Checkout
        </button>
        <p id="cart-note" class="mt-2 hidden text-center text-[13px] text-muted"></p>
      </div>
    </aside>

    <script>
      import { cartLines, setQuantity, cartCount, cartTotal } from '../lib/cart';
      import type { CartLine } from '../lib/commerce/types';

      const $ = (id: string) => document.getElementById(id)!;
      const provider = document.body.dataset.provider;

      function money(n: number) {
        return '$' + (Math.round(n * 100) / 100).toString();
      }

      function render() {
        const lines = cartLines.get();
        const countEl = $('cart-count');
        const n = cartCount();
        countEl.textContent = String(n);
        countEl.classList.toggle('hidden', n === 0);

        const box = $('cart-lines');
        if (!lines.length) {
          box.innerHTML =
            '<p class="py-16 text-center text-[15px] text-muted">Your cart is empty.<br/>Everything ships free over $75.</p>';
        } else {
          box.innerHTML = lines
            .map(
              (l) => `
              <div class="flex gap-4 border-b border-line py-4" data-line="${l.variantId}">
                ${l.image ? `<img src="${l.image.src}" alt="" class="h-20 w-20 rounded-md bg-tile object-cover"/>` : ''}
                <div class="flex-1">
                  <p class="text-[15px] font-medium">${l.title}</p>
                  <p class="text-[13px] text-muted">${l.variantTitle}</p>
                  <div class="mt-2 flex items-center gap-3">
                    <div class="flex items-center rounded-md border border-line">
                      <button class="px-2.5 py-1 text-muted hover:text-ink" data-qty="-1" aria-label="Decrease quantity">−</button>
                      <span class="px-1 text-[14px]">${l.quantity}</span>
                      <button class="px-2.5 py-1 text-muted hover:text-ink" data-qty="1" aria-label="Increase quantity">+</button>
                    </div>
                    <span class="text-[14px] font-medium">${money(l.price.amount * l.quantity)}</span>
                  </div>
                </div>
              </div>`,
            )
            .join('');
        }
        $('cart-subtotal').textContent = money(cartTotal());
        ($('cart-checkout') as HTMLButtonElement).disabled = lines.length === 0;
      }

      function open() {
        document.body.classList.add('cart-open');
      }
      function close() {
        document.body.classList.remove('cart-open');
      }

      const menuBtn = document.getElementById('menu-button');
      const mobileMenu = document.getElementById('mobile-menu');
      menuBtn?.addEventListener('click', () => {
        const hidden = mobileMenu!.classList.toggle('hidden');
        menuBtn.setAttribute('aria-expanded', String(!hidden));
      });

      $('cart-button').addEventListener('click', open);
      $('cart-close').addEventListener('click', close);
      $('cart-backdrop').addEventListener('click', close);
      function closeThanks() {
        const modal = $('thanks-modal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
      document.querySelectorAll('[data-thanks-close]').forEach((el) => el.addEventListener('click', closeThanks));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          close();
          closeThanks();
        }
      });

      $('cart-lines').addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('[data-qty]') as HTMLElement | null;
        if (!btn) return;
        const row = btn.closest('[data-line]') as HTMLElement;
        const line = cartLines.get().find((l) => l.variantId === row.dataset.line);
        if (line) setQuantity(line.variantId, line.quantity + Number(btn.dataset.qty));
      });

      // Add-to-cart: any element with data-cart-line='{json CartLine}'
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest('[data-cart-line]') as HTMLElement | null;
        if (!el) return;
        const line = JSON.parse(el.dataset.cartLine!) as CartLine;
        const qtyInput = document.querySelector('[data-qty-input]') as HTMLInputElement | null;
        line.quantity = qtyInput ? Math.max(1, Number(qtyInput.value)) : 1;
        const picked = document.querySelector('[data-variant-picker] [aria-pressed="true"]') as HTMLElement | null;
        if (picked) {
          line.variantId = picked.dataset.variantId!;
          line.variantTitle = picked.dataset.variantTitle!;
        }
        import('../lib/cart').then(({ addLine }) => {
          addLine(line);
          open();
        });
      });

      $('cart-checkout').addEventListener('click', async () => {
        const lines = cartLines.get();
        if (!lines.length) return;
        const note = $('cart-note');
        if (provider !== 'shopify') {
          close();
          const modal = $('thanks-modal');
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          return;
        }
        const btn = $('cart-checkout') as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = 'Preparing checkout…';
        try {
          const res = await fetch(
            `https://${import.meta.env.PUBLIC_SHOPIFY_DOMAIN}/api/2025-07/graphql.json`,
            {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-Shopify-Storefront-Access-Token': import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_TOKEN,
              },
              body: JSON.stringify({
                query: `mutation ($lines: [CartLineInput!]!) {
                  cartCreate(input: { lines: $lines }) { cart { checkoutUrl } userErrors { message } }
                }`,
                variables: {
                  lines: lines.map((l) => ({ merchandiseId: l.variantId, quantity: l.quantity })),
                },
              }),
            },
          );
          const json = await res.json();
          const url = json.data?.cartCreate?.cart?.checkoutUrl;
          if (url) location.href = url;
          else throw new Error(json.data?.cartCreate?.userErrors?.[0]?.message ?? 'cartCreate failed');
        } catch (err) {
          note.textContent = 'Checkout failed: ' + (err as Error).message;
          note.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = 'Checkout';
        }
      });

      cartLines.subscribe(render);
      render();
    </script>
  </body>
</html>
