---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { commerce } from '../lib/commerce';
import { HOME as T } from '../constants/pages';

const [products, collections] = await Promise.all([
  commerce.listProducts({ limit: 8 }),
  commerce.listCollections(),
]);
const shelfImages: Record<string, string> = {
  apparel: '/products/deep-work-hoodie.jpg',
  desk: '/products/walnut-laptop-stand.jpg',
  coffee: '/products/midnight-roast.jpg',
};
---

<Layout>
  <!-- Hero -->
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-5 pb-4 pt-6 md:grid-cols-[1.1fr_1fr] md:pb-16 md:pt-20">
    <div>
      <h1 class="font-display text-[clamp(40px,6vw,72px)] font-extrabold leading-[0.98] tracking-tight">
        {T.hero.title}
      </h1>
      <p class="mt-5 max-w-[44ch] text-[17px] leading-relaxed text-muted">{T.hero.text}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={T.hero.ctaPrimary.href} class="rounded-md bg-pine px-6 py-3.5 text-[15px] font-semibold text-white hover:bg-pine-deep">
          {T.hero.ctaPrimary.label}
        </a>
        <a href={T.hero.ctaSecondary.href} class="rounded-md border border-ink px-6 py-3.5 text-[15px] font-semibold hover:bg-tile">
          {T.hero.ctaSecondary.label}
        </a>
      </div>
      <p class="mt-6 text-[13px] text-muted">{T.hero.note}</p>
    </div>
    <div class="overflow-hidden rounded-xl bg-tile">
      <img src={T.hero.image.src} alt={T.hero.image.alt} class="aspect-[4/5] w-full object-cover" />
    </div>
  </section>

  <!-- Theme bar: quiet strip under the hero -->
  <div class="border-y border-line bg-tile/50">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-5 gap-y-1 px-5 py-3 text-[13px] text-muted">
      <span>{T.themeBar.text}</span>
      <a href={T.themeBar.cta.href} class="font-semibold text-ink underline underline-offset-4 hover:text-pine">{T.themeBar.cta.label}</a>
      <a href={T.themeBar.cta2.href} class="font-semibold text-ink underline underline-offset-4 hover:text-pine">{T.themeBar.cta2.label}</a>
    </div>
  </div>

  <!-- Collections shelf -->
  <section class="mx-auto max-w-6xl px-5 py-4 sm:py-14">
    <h2 class="font-display text-3xl font-bold tracking-tight">{T.collections.title}</h2>
    <div class="mt-7 grid gap-5 sm:grid-cols-3">
      {collections.filter((c) => shelfImages[c.handle]).map((c) => (
        <a href={`/collections/${c.handle}`} class="group block">
          <div class="overflow-hidden rounded-lg bg-tile">
            <img
              src={shelfImages[c.handle]}
              alt={c.title}
              class="aspect-[4/3] w-full object-cover transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>
          <h3 class="mt-3 text-[17px] font-semibold group-hover:underline group-hover:underline-offset-4">{c.title}</h3>
          <p class="mt-1 text-[14px] text-muted">{c.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Products -->
  <section class="mx-auto max-w-6xl px-5 py-4 sm:py-14">
    <div class="flex items-baseline justify-between">
      <h2 class="font-display text-3xl font-bold tracking-tight">{T.products.title}</h2>
      <p class="text-[14px] text-muted">{products.length} {T.products.countLabel}</p>
    </div>
    <div class="mt-7 grid grid-cols-2 gap-x-5 gap-y-5 md:grid-cols-4">
      {products.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <!-- Values -->
  <section class="mx-auto max-w-6xl px-5 pb-4 sm:pb-8">
    <div class="grid gap-4 rounded-2xl border border-line bg-tile/60 p-4 sm:grid-cols-3 sm:gap-8 sm:p-10">
      <div>
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-pine-soft text-pine">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3 9 5-9 5-9-5 9-5z" /><path d="m3 12.5 9 5 9-5" /><path d="m3 17 9 5 9-5" />
          </svg>
        </span>
        <h3 class="mt-4 text-[16px] font-semibold">{T.values[0].title}</h3>
        <p class="mt-2 text-[14px] leading-relaxed text-muted">{T.values[0].text}</p>
      </div>
      <div>
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-pine-soft text-pine">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="12" cy="12" rx="7" ry="9" /><path d="M12 3c-3 3.5-3 14.5 0 18" transform="rotate(35 12 12)" />
          </svg>
        </span>
        <h3 class="mt-4 text-[16px] font-semibold">{T.values[1].title}</h3>
        <p class="mt-2 text-[14px] leading-relaxed text-muted">{T.values[1].text}</p>
      </div>
      <div>
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-pine-soft text-pine">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 14 4 9l5-5" /><path d="M4 9h10a6 6 0 0 1 0 12h-3" />
          </svg>
        </span>
        <h3 class="mt-4 text-[16px] font-semibold">{T.values[2].title}</h3>
        <p class="mt-2 text-[14px] leading-relaxed text-muted">{T.values[2].text}</p>
      </div>
    </div>
  </section>

  <!-- Quote -->
  <section class="mx-auto max-w-3xl px-5 py-10 text-center sm:py-16">
    <blockquote class="font-display text-[clamp(22px,3vw,30px)] font-semibold leading-snug">
      {T.quote.text}
    </blockquote>
    <p class="mt-4 text-[14px] text-muted">{T.quote.author}</p>
  </section>

  <!-- Theme colophon: this store is the product -->
  <section class="mx-auto max-w-6xl px-5 pb-4 sm:pb-8">
    <div class="grid gap-5 rounded-2xl border border-pine-deep bg-pine p-4 text-white sm:gap-10 sm:p-10 md:grid-cols-[1.2fr_1fr] md:items-center">
      <div>
        <p class="text-[13px] font-medium text-white/70">{T.colophon.eyebrow}</p>
        <h2 class="mt-3 font-display text-[clamp(26px,3.5vw,38px)] font-bold leading-tight tracking-tight">
          {T.colophon.title}
        </h2>
        <p class="mt-4 max-w-[52ch] text-[15px] leading-relaxed text-white/85">{T.colophon.text}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={T.colophon.ctaPrimary.href} class="rounded-md bg-white px-6 py-3.5 text-[15px] font-semibold text-pine hover:bg-white/90">
            {T.colophon.ctaPrimary.label}
          </a>
          <a href={T.colophon.ctaSecondary.href} class="rounded-md border border-white/40 px-6 py-3.5 text-[15px] font-semibold text-white hover:bg-white/10">
            {T.colophon.ctaSecondary.label}
          </a>
          <a href={T.colophon.ctaThemes.href} class="px-2 py-3.5 text-[15px] font-semibold text-white/80 underline decoration-white/40 underline-offset-4 hover:text-white">
            {T.colophon.ctaThemes.label}
          </a>
        </div>
      </div>
      <ul class="grid min-w-0 gap-3 rounded-xl bg-pine-deep/60 p-4 text-[14px] leading-relaxed sm:p-7">
        {T.colophon.stack.map((s, i) => (
          <li class="flex gap-3">
            <span class="mt-0.5 text-white/60">{String(i + 1).padStart(2, '0')}</span>
            <span><strong class="font-semibold">{s.strong}</strong> {s.text}</span>
          </li>
        ))}
        <li>
          <button
            type="button"
            data-copy-env={T.colophon.env.copyValue}
            class="group/copy mt-2 flex w-full items-center justify-between gap-3 rounded-md bg-black/25 px-4 py-2.5 text-left font-mono text-[13px] text-white/90 transition hover:bg-black/35"
            aria-label={`Copy ${T.colophon.env.copyValue} to clipboard`}
          >
            <span>{T.colophon.env.prefix}<span class="text-white">{T.colophon.env.value}</span></span>
            <span data-copy-icon class="text-white/60 transition group-hover/copy:text-white">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" />
              </svg>
            </span>
            <span data-copy-done class="hidden text-[12px] font-sans font-semibold text-white">{T.colophon.env.copiedLabel}</span>
          </button>
        </li>
      </ul>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy-env]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(btn.dataset.copyEnv!);
        const icon = btn.querySelector('[data-copy-icon]')!;
        const done = btn.querySelector('[data-copy-done]')!;
        icon.classList.add('hidden');
        done.classList.remove('hidden');
        setTimeout(() => {
          done.classList.add('hidden');
          icon.classList.remove('hidden');
        }, 1600);
      });
    });
  </script>
</Layout>
