---
import Layout from '../../layouts/Layout.astro';
import { commerce } from '../../lib/commerce';

export async function getStaticPaths() {
  const products = await commerce.listProducts();
  return products.map((p) => ({ params: { handle: p.handle }, props: { product: p } }));
}

const { product } = Astro.props;
const img = product.images[0];
---

<Layout title={`${product.title} — njX Store`} description={product.description}>
  <div class="grid gap-10 md:grid-cols-2">
    <div class="aspect-square overflow-hidden rounded-xl bg-neutral-900">
      {img && <img src={img.src} alt={img.alt} class="h-full w-full object-cover" />}
    </div>
    <div>
      <h1 class="text-3xl font-black">{product.title}</h1>
      <p class="mt-2 text-xl text-neutral-300">
        ${product.price.amount}
        {product.compareAtPrice && <s class="ml-2 text-neutral-600">${product.compareAtPrice.amount}</s>}
      </p>
      <p class="mt-5 leading-relaxed text-neutral-400">{product.description}</p>

      <div class="mt-6 flex flex-wrap gap-2">
        {product.variants.map((v) => (
          <span
            class:list={[
              'rounded-lg border px-3 py-1.5 text-sm',
              v.available ? 'border-neutral-600' : 'border-neutral-800 text-neutral-600 line-through',
            ]}
          >
            {v.title}
          </span>
        ))}
      </div>

      <button class="mt-8 rounded-xl bg-white px-6 py-3 font-bold text-black" data-add-to-cart={product.variants[0]?.id}>
        Add to cart
      </button>
      <p class="mt-3 text-xs text-neutral-500">Cart wiring lands with the design sprint.</p>
    </div>
  </div>
</Layout>
