---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacts — njX Shop" description="Questions about an order, sizing or wholesale — write to njX Shop.">
  <section class="mx-auto max-w-6xl px-5 pb-4 sm:pb-8 pt-6 sm:pt-12">
    <h1 class="font-display text-[clamp(32px,5vw,52px)] font-extrabold tracking-tight">Talk to us</h1>
    <p class="mt-3 max-w-[52ch] text-[16px] leading-relaxed text-muted">
      Orders, sizing, wholesale, or just to tell us what to make next.
      A human answers — usually within a day.
    </p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-6 px-5 pb-8 sm:pb-16 md:grid-cols-[1fr_1.3fr]">
    <div class="space-y-4">
      <div class="rounded-2xl border border-line bg-tile/60 p-6">
        <h2 class="text-[15px] font-semibold">Email</h2>
        <a href="mailto:hi@njx-shop.demo" class="mt-1 block text-[15px] text-pine underline underline-offset-2">hi@njx-shop.demo</a>
        <p class="mt-2 text-[13px] text-muted">Order number in the subject speeds things up.</p>
      </div>
      <div class="rounded-2xl border border-line bg-tile/60 p-6">
        <h2 class="text-[15px] font-semibold">Warehouse</h2>
        <p class="mt-1 text-[15px] text-muted">Unit 4, 12 Roastery Lane<br />Portland, OR — by appointment</p>
      </div>
      <div class="rounded-2xl border border-line bg-tile/60 p-6">
        <h2 class="text-[15px] font-semibold">Elsewhere</h2>
        <ul class="mt-2 space-y-1.5 text-[15px] text-muted">
          <li><a href="https://github.com/njbSaab/astro-njx-store" class="hover:text-ink">GitHub — this theme</a></li>
          <li><a href="https://njxui.dev" class="hover:text-ink">njX UI — the library</a></li>
        </ul>
      </div>
    </div>

    <form
      class="rounded-2xl border border-line bg-tile/40 p-6 sm:p-8"
      x-ignore
      data-contact-form
      novalidate
    >
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="text-[13px] font-medium">Name</span>
          <input type="text" name="name" required placeholder="Alex Builder"
            class="mt-1.5 w-full rounded-md border border-line bg-paper px-3.5 py-3 text-[15px] outline-none placeholder:text-muted focus:border-pine" />
        </label>
        <label class="block">
          <span class="text-[13px] font-medium">Email</span>
          <input type="email" name="email" required placeholder="you@work.com"
            class="mt-1.5 w-full rounded-md border border-line bg-paper px-3.5 py-3 text-[15px] outline-none placeholder:text-muted focus:border-pine" />
        </label>
      </div>
      <label class="mt-4 block">
        <span class="text-[13px] font-medium">Message</span>
        <textarea name="message" rows="6" required placeholder="What's on your mind?"
          class="mt-1.5 w-full resize-y rounded-md border border-line bg-paper px-3.5 py-3 text-[15px] outline-none placeholder:text-muted focus:border-pine"></textarea>
      </label>
      <button type="submit" class="mt-5 w-full rounded-md bg-pine py-3.5 text-[15px] font-semibold text-white hover:bg-pine-deep sm:w-auto sm:px-8">
        Send message
      </button>
      <p data-contact-note class="mt-4 hidden rounded-md bg-pine-soft px-4 py-3 text-[13px] leading-relaxed"></p>
    </form>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]')!;
    const note = document.querySelector<HTMLElement>('[data-contact-note]')!;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      note.textContent = "Demo mode — the form isn't wired to a backend. Point it at your email service or an API route.";
      note.classList.remove('hidden');
    });
  </script>
</Layout>
