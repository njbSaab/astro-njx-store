---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — njX Shop">
  <section class="mx-auto max-w-2xl px-5 py-24 text-center">
    <h1 class="font-display text-[clamp(40px,7vw,72px)] font-extrabold tracking-tight">Nothing here.</h1>
    <p class="mt-4 text-[16px] text-muted">
      This page moved, sold out, or never existed. The good stuff is one click away.
    </p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="rounded-md bg-pine px-6 py-3.5 text-[15px] font-semibold text-white hover:bg-pine-deep">Back to the store</a>
      <a href="/collections/coffee" class="rounded-md border border-ink px-6 py-3.5 text-[15px] font-semibold hover:bg-tile">Get coffee instead</a>
    </div>
  </section>
</Layout>
