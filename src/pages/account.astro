---
// Auth page: sign in / create account switcher. Demo-only submit —
// wire it to Shopify Customer Accounts or your own backend.
import Layout from '../layouts/Layout.astro';
---

<Layout title="Account — njX Shop" description="Sign in to your njX Shop account or create a new one.">
  <section class="mx-auto max-w-md px-5 py-10 sm:py-16">
    <div class="rounded-xl border border-line bg-tile/40 p-5 sm:p-8">
      <div class="grid grid-cols-2 gap-1 rounded-md bg-tile p-1 text-[14px] font-medium" role="tablist" aria-label="Auth mode">
        <button
          type="button"
          data-auth-tab="login"
          role="tab"
          aria-selected="true"
          class="rounded-[5px] py-2.5 text-muted transition aria-selected:bg-paper aria-selected:font-semibold aria-selected:text-ink aria-selected:shadow-sm"
        >Sign in</button>
        <button
          type="button"
          data-auth-tab="register"
          role="tab"
          aria-selected="false"
          class="rounded-[5px] py-2.5 text-muted transition aria-selected:bg-paper aria-selected:font-semibold aria-selected:text-ink aria-selected:shadow-sm"
        >Create account</button>
      </div>

      <h1 data-auth-title class="mt-7 font-display text-2xl font-bold">Welcome back</h1>
      <p data-auth-sub class="mt-1.5 text-[14px] text-muted">Orders, addresses and faster checkout.</p>

      <form data-auth-form class="mt-6 space-y-4" novalidate>
        <label data-field="name" class="hidden">
          <span class="text-[13px] font-medium">Name</span>
          <input
            type="text"
            name="name"
            autocomplete="name"
            placeholder="Alex Builder"
            class="mt-1.5 w-full rounded-md border border-line bg-paper px-3.5 py-3 text-[15px] outline-none placeholder:text-muted focus:border-pine"
          />
        </label>
        <label class="block">
          <span class="text-[13px] font-medium">Email</span>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@work.com"
            class="mt-1.5 w-full rounded-md border border-line bg-paper px-3.5 py-3 text-[15px] outline-none placeholder:text-muted focus:border-pine"
          />
        </label>
        <label class="block">
          <span class="text-[13px] font-medium">Password</span>
          <input
            type="password"
            name="password"
            required
            minlength="8"
            autocomplete="current-password"
            placeholder="••••••••"
            class="mt-1.5 w-full rounded-md border border-line bg-paper px-3.5 py-3 text-[15px] outline-none placeholder:text-muted focus:border-pine"
          />
        </label>
        <div class="flex items-center justify-between text-[13px]">
          <label class="flex items-center gap-2 text-muted">
            <input type="checkbox" name="remember" class="h-4 w-4 accent-pine" />
            Remember me
          </label>
          <a data-field="forgot" href="#" class="text-muted underline underline-offset-2 hover:text-ink">Forgot password?</a>
        </div>
        <button type="submit" data-auth-submit class="w-full rounded-md bg-pine py-3.5 text-[15px] font-semibold text-white hover:bg-pine-deep">
          Sign in
        </button>
        <p data-auth-note class="hidden rounded-md bg-pine-soft px-4 py-3 text-center text-[13px] leading-relaxed"></p>
      </form>
    </div>
    <p class="mt-5 text-center text-[13px] text-muted">
      Demo page — wire it to Shopify Customer Accounts or your own auth backend.
    </p>
  </section>

  <script>
    const tabs = document.querySelectorAll<HTMLElement>('[data-auth-tab]');
    const title = document.querySelector('[data-auth-title]')!;
    const sub = document.querySelector('[data-auth-sub]')!;
    const nameField = document.querySelector<HTMLElement>('[data-field="name"]')!;
    const forgot = document.querySelector<HTMLElement>('[data-field="forgot"]')!;
    const submit = document.querySelector('[data-auth-submit]')!;
    const note = document.querySelector<HTMLElement>('[data-auth-note]')!;
    const form = document.querySelector<HTMLFormElement>('[data-auth-form]')!;
    let mode: 'login' | 'register' = 'login';

    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        mode = t.dataset.authTab as typeof mode;
        tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
        const reg = mode === 'register';
        nameField.classList.toggle('hidden', !reg);
        nameField.classList.toggle('block', reg);
        forgot.classList.toggle('hidden', reg);
        title.textContent = reg ? 'Join njX Shop' : 'Welcome back';
        sub.textContent = reg ? 'One account for orders, returns and early drops.' : 'Orders, addresses and faster checkout.';
        submit.textContent = reg ? 'Create account' : 'Sign in';
        note.classList.add('hidden');
      }),
    );

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      note.textContent =
        mode === 'register'
          ? 'Demo mode — account creation is a stub. Connect Shopify Customer Accounts or your own backend here.'
          : 'Demo mode — sign-in is a stub. Connect Shopify Customer Accounts or your own backend here.';
      note.classList.remove('hidden');
    });
  </script>
</Layout>
